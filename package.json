{
  "name": "fender-studio-mcp",
  "version": "0.4.0",
  "description": "MCP server for Fender Studio Pro 8 (formerly PreSonus Studio One): read .song files, control the running app through an in-app bridge device, and capture + analyze its audio output.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4blue/fender-studio-mcp.git"
  },
  "homepage": "https://github.com/b4blue/fender-studio-mcp#readme",
  "bugs": {
    "url": "https://github.com/b4blue/fender-studio-mcp/issues"
  },
  "type": "module",
  "bin": {
    "fender-studio-mcp": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "install-device": "node scripts/install-device.js",
    "test:live": "node --test --test-concurrency=1 test/live/*.test.js",
    "setup": "node src/cli.js setup",
    "doctor": "node src/cli.js doctor",
    "build:audio": "sh audio/build.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "fender",
    "studio-pro",
    "studio-one",
    "presonus",
    "daw",
    "mixing",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "zod": "^4.6.5"
  },
  "files": [
    "src",
    "device",
    "scripts",
    "audio/analyze.py",
    "audio/build.sh",
    "audio/requirements.txt",
    "audio/tap",
    "README.md",
    "LICENSE"
  ],
  "contributors": [
    "Adam Morgan (original studio-one-mcp)",
    "Boris Miljkovic (Studio Pro 8 fork)"
  ]
}
